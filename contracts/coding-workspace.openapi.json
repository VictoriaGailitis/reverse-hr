  "components": {
    "schemas": {
      "ArtifactReceipt": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Candidate Id"
          },
          "nonce": {
            "type": "string",
            "format": "uuid",
            "title": "Nonce"
          },
          "requester": {
            "type": "string",
            "const": "evaluation",
            "title": "Requester"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time",
            "title": "Issued At"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "stage_id": {
            "type": "string",
            "format": "uuid",
            "title": "Stage Id"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "title": "Workspace Id"
          },
          "snapshot_id": {
            "type": "string",
            "format": "uuid",
            "title": "Snapshot Id"
          },
          "purpose": {
            "type": "string",
            "const": "rubric-evidence",
            "title": "Purpose",
            "default": "rubric-evidence"
          },
          "format": {
            "type": "string",
            "enum": [
              "code",
              "sql"
            ],
            "title": "Format"
          },
          "snapshot_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Snapshot Version"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Digest"
          },
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "manifest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FilesCommand"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidate_id",
          "nonce",
          "requester",
          "issued_at",
          "session_id",
          "stage_id",
          "workspace_id",
