  "components": {
    "schemas": {
      "ContactsCommand": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30,
                "minLength": 3,
                "pattern": "^\\+?[0-9 ()-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email"
        ],
        "title": "ContactsCommand"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fields"
          },
          "trace_id": {
            "type": "string",
            "format": "uuid",
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "trace_id"
        ],
        "title": "ErrorResponse"
      },
      "Grade": {
        "type": "string",
        "enum": [
          "junior",
          "middle",
          "senior",
          "lead"
        ],
        "title": "Grade"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse"
      },
      "HistoryItem": {
        "properties": {
          "specialization": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Specialization"
          },
          "target_grade": {
            "$ref": "#/components/schemas/Grade"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "rejected",
              "technical_failure"
            ],
            "title": "Status"
          },
          "decided_at": {
            "type": "string",
            "format": "date-time",
            "title": "Decided At"
          },
          "demo": {
            "type": "boolean",
            "const": true,
            "title": "Demo",
            "default": true
          },
          "decision_id": {
            "type": "string",
            "format": "uuid",
            "title": "Decision Id"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "specialization",
          "target_grade",
          "status",
          "decided_at",
          "decision_id",
          "session_id"
        ],
        "title": "HistoryItem"
      },
      "MarketReceipt": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Candidate Id"
          },
          "nonce": {
            "type": "string",
            "format": "uuid",
            "title": "Nonce"
          },
          "requester": {
            "type": "string",
            "enum": [
              "candidate",
              "matching",
              "hiring",
              "notification",
              "assessment"
            ],
            "title": "Requester"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time",
            "title": "Issued At"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "profile",
              "membership",
              "affiliation",
              "content-membership",
              "need",
              "purpose-permission",
              "contact-permission",
              "contacts",
              "notice"
            ],
            "title": "Purpose"
          },
          "organization_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organization Id"
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Id"
          },
          "notice_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notice Id"
          },
          "need_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Need Id"
          },
          "invitation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invitation Id"
          },
          "consent_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consent Id"
          },
          "consent_purpose": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "profile_publication",
                  "contact_disclosure"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Consent Purpose"
          },
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision",
            "default": 0
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
