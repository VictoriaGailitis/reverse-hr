FROM python:3.12.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils tesseract-ocr tesseract-ocr-eng tesseract-ocr-rus fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY src ./src
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN useradd --uid 10001 --create-home app \
    && mkdir /run/pdf && chown app:app /run/pdf && chmod 700 /run/pdf
USER app
CMD ["uvicorn", "reverse_hr.resume_pdf_guest:create_app", "--factory", "--uds", "/run/pdf/pdf.sock", "--workers", "1", "--no-access-log"]
