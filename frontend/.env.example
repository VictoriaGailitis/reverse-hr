# Public frontend configuration. Never put tokens/client secrets in VITE_* variables.
VITE_BACKEND_MODE=demo
VITE_API_BASE_URL=/api
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=reverse-hr
VITE_KEYCLOAK_CLIENT_ID=reverse-hr-web
# Existing Keycloak realm permits http://localhost:3000/auth/callback.
# To use that callback, start at http://localhost:3000 and set VITE_DEV_PORT=3000.
# Alternatively configure http://127.0.0.1:5175/auth/callback and its web origin in Keycloak.
VITE_DEV_PORT=5175
