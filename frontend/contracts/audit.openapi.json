  "components": {
    "schemas": {
      "DisclosureReceipt": {
        "properties": {
          "owner": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Owner"
          },
          "kind": {
            "type": "string",
            "enum": [
              "contacts",
              "resume_pdf",
              "ats_export",
              "external_delivery"
            ],
            "title": "Kind"
          },
          "effect_id": {
            "type": "string",
            "format": "uuid",
            "title": "Effect Id"
          },
          "resource_id": {
            "type": "string",
            "format": "uuid",
            "title": "Resource Id"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "title": "Actor Id"
          },
          "candidate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Candidate Id"
          },
          "organization_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organization Id"
          },
          "recipient_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipient Id"
          },
          "nonce": {
            "type": "string",
            "format": "uuid",
            "title": "Nonce"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time",
            "title": "Issued At"
          },
          "entry_id": {
            "type": "string",
            "format": "uuid",
            "title": "Entry Id"
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Digest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "owner",
          "kind",
          "effect_id",
          "resource_id",
          "actor_id",
          "candidate_id",
          "nonce",
          "issued_at",
          "entry_id",
          "content_digest"
        ],
        "title": "DisclosureReceipt"
      },
      "DisclosureRequest": {
        "properties": {
          "owner": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Owner"
          },
          "kind": {
            "type": "string",
            "enum": [
              "contacts",
              "resume_pdf",
              "ats_export",
              "external_delivery"
            ],
            "title": "Kind"
          },
          "effect_id": {
            "type": "string",
            "format": "uuid",
            "title": "Effect Id"
          },
          "resource_id": {
            "type": "string",
            "format": "uuid",
            "title": "Resource Id"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "title": "Actor Id"
          },
          "candidate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Candidate Id"
          },
          "organization_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organization Id"
          },
          "recipient_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipient Id"
          },
          "nonce": {
            "type": "string",
            "format": "uuid",
            "title": "Nonce"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time",
            "title": "Issued At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "owner",
          "kind",
          "effect_id",
          "resource_id",
          "actor_id",
          "candidate_id",
          "nonce",
          "issued_at"
        ],
        "title": "DisclosureRequest"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fields"
          },
          "trace_id": {
            "type": "string",
            "format": "uuid",
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "trace_id"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse"
      },
      "RightsExchange": {
        "properties": {
          "requester": {
            "type": "string",
            "title": "Requester"
          },
          "operation": {
            "type": "string",
            "enum": [
              "permission",
              "export",
              "correct",
              "export-page"
            ],
            "title": "Operation"
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16384
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          },
          "candidate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Candidate Id"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "nonce": {
            "type": "string",
            "format": "uuid",
            "title": "Nonce"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time",
            "title": "Issued At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requester",
          "operation",
          "candidate_id",
          "request_id",
          "revision",
          "nonce",
          "issued_at"
        ],
        "title": "RightsExchange"
      },
      "RightsReceipt": {
        "properties": {
          "request_digest": {
            "type": "string",
            "title": "Request Digest"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time",
            "title": "Issued At"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_digest",
          "issued_at",
          "data"
        ],
        "title": "RightsReceipt"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
