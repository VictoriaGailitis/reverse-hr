{
  "openapi": "3.1.0",
  "info": {
    "title": "Reverse HR / audit",
    "description": "Service API; implemented routes are listed below.",
    "version": "0.1.0"
  },
  "paths": {
    "/internal/v1/subject-rights/{operation}": {
      "post": {
        "tags": [
          "internal-subject-rights"
        ],
        "summary": "Exchange",
        "operationId": "exchange_internal_v1_subject_rights__operation__post",
        "parameters": [
          {
            "name": "operation",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Operation"
            }
          },
          {
            "name": "X-HR-Signature",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Hr-Signature"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RightsExchange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RightsReceipt"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
