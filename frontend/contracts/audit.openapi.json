    "/internal/v1/audit/disclosures": {
      "post": {
        "tags": [
          "internal-audit"
        ],
        "summary": "Disclosure",
        "operationId": "disclosure_internal_v1_audit_disclosures_post",
        "parameters": [
          {
            "name": "X-HR-Signature",
            "in": "header",
            "required": true,
